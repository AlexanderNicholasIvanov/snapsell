# Copy to deploy/.env. Read by both containers.

# Public hostname served by Caddy. DNS for it must point at this machine.
# Use ":80" to test locally over plain http.
SNAPSELL_DOMAIN=api.example.com
# Loopback port the backend container publishes on the host (what the reverse proxy targets).
SNAPSELL_BACKEND_PORT=8100
# Host ports the optional caddy container binds (--profile caddy). Only change for local testing.
SNAPSELL_HTTP_PORT=80
SNAPSELL_HTTPS_PORT=443

# Anthropic. The SDK reads this variable directly.
ANTHROPIC_API_KEY=sk-ant-...

# eBay application keyset (Production or Sandbox, matching SNAPSELL_EBAY_ENV).
SNAPSELL_EBAY_CLIENT_ID=
SNAPSELL_EBAY_CLIENT_SECRET=
SNAPSELL_EBAY_ENV=production
SNAPSELL_EBAY_MARKETPLACE=EBAY_US

# Comma-separated emails allowed to use the backend. Empty means any signed-in Firebase user.
# Firebase Admin credentials come from deploy/firebase-service-account.json (see README).
SNAPSELL_ALLOWED_EMAILS=you@example.com

# Local testing only. Never set this on a deployed instance.
SNAPSELL_AUTH_DISABLED=0

# Per-user cap on LLM-backed calls per UTC day.
SNAPSELL_DAILY_CAP=200
