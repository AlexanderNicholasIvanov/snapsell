# Copy to .env for local runs (uvicorn does not load it automatically; use `uv run --env-file .env ...`).

# Anthropic. The SDK reads this variable directly.
ANTHROPIC_API_KEY=sk-ant-...

# eBay application keyset (Production or Sandbox, matching SNAPSELL_EBAY_ENV).
SNAPSELL_EBAY_CLIENT_ID=
SNAPSELL_EBAY_CLIENT_SECRET=
SNAPSELL_EBAY_ENV=production
SNAPSELL_EBAY_MARKETPLACE=EBAY_US

# Firebase Admin credentials. On Cloud Run leave unset and use the service account's ADC.
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Comma-separated emails allowed to use the backend. Empty means any signed-in Firebase user.
SNAPSELL_ALLOWED_EMAILS=you@example.com,friend@example.com

# Local development only. Never set this on a deployed instance.
SNAPSELL_AUTH_DISABLED=0

# Per-user cap on LLM-backed calls per UTC day (best effort, in-memory).
SNAPSELL_DAILY_CAP=200
